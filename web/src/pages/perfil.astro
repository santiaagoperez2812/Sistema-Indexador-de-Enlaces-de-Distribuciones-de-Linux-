---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi Perfil - Distribuciones Guardadas">
  <style>
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; min-height: 70vh; }
    header { text-align: center; margin-bottom: 3rem; }
    h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; }
    
    /* Reutilizamos el grid de tu página principal */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 2rem; }
    
    /* Clases básicas para las tarjetas inyectadas por JS */
    :global(.card) { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 16px; padding: 1.8rem; display: flex; flex-direction: column; }
    :global(.card-header) { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    :global(.card-logo) { width: 54px; height: 54px; object-fit: contain; background: #f8fafc; padding: 8px; border-radius: 12px; }
    :global(.card-title-group h2) { font-size: 1.4rem; font-weight: 600; margin: 0; }
    :global(.card-title-group span) { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; }
    :global(.card-desc) { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.2rem; flex-grow: 1; }
    :global(.btn) { display: inline-block; text-decoration: none; font-size: 0.85rem; padding: 0.5rem 0.8rem; border-radius: 8px; background: rgba(255,255,255,0.05); color: white; border: 1px solid transparent; }
    
    #estado { text-align: center; color: var(--text-muted); font-size: 1.2rem; margin-top: 2rem; }
  </style>

  <div class="container">
    <header>
      <h1>Mi Colección</h1>
      <p style="color: var(--text-muted);">Tus distribuciones de Linux favoritas</p>
    </header>

    <div id="estado">Cargando tus favoritos...</div>
    <div class="grid" id="contenedor-favoritos"></div>
  </div>

  <script>
    async function cargarFavoritos() {
      const estado = document.getElementById('estado');
      const contenedor = document.getElementById('contenedor-favoritos');

      try {
        const respuesta = await fetch('https://santiagoperez.pythonanywhere.com/api/favorites', {
          method: 'GET',
          credentials: 'include' // Obligatorio para enviar la sesión de GitHub
        });

        if (respuesta.status === 401) {
          estado.innerHTML = 'Debes <a href="https://santiagoperez.pythonanywhere.com/login" style="color: #38bdf8;">iniciar sesión con GitHub</a> para ver tus favoritos.';
          return;
        }

        const distros = await respuesta.json();

        if (distros.length === 0) {
          estado.innerText = 'Aún no tienes distribuciones guardadas. ¡Ve al inicio y guarda algunas!';
          return;
        }

        // Si hay distros, ocultamos el mensaje de estado y dibujamos las tarjetas
        estado.style.display = 'none';
        
        distros.forEach(distro => {
          const tarjeta = document.createElement('div');
          tarjeta.className = 'card';
          
          const logoSrc = distro.logo && distro.logo.startsWith('http') ? distro.logo : '/logo-placeholder.png'; // Ajusta la ruta base si es necesario

          tarjeta.innerHTML = `
            <div class="card-header">
              <img src="${logoSrc}" alt="Logo" class="card-logo" onerror="this.style.display='none'">
              <div class="card-title-group">
                <h2>${distro.name}</h2>
                <span>${distro.family}</span>
              </div>
            </div>
            <p class="card-desc">${distro.description || 'Sin descripción.'}</p>
            <div>
              ${distro.links && distro.links.website ? `<a href="${distro.links.website}" target="_blank" class="btn">Sitio Web</a>` : ''}
            </div>
          `;
          contenedor.appendChild(tarjeta);
        });

      } catch (error) {
        console.error("Error cargando favoritos:", error);
        estado.innerText = 'Ocurrió un error al cargar tus favoritos. Intenta recargar la página.';
      }
    }

    // Ejecutar al cargar la página
    cargarFavoritos();
  </script>
</Layout>